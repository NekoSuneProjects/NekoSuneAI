      {"key": "w", "seconds": 0.5}
    ],
    "generic.interact": [
      {"key": "e", "seconds": 0.08}
    ],
    "generic.look": [
      {"key": "right", "seconds": 0.2}
    ],
    "generic.open_menu": [
      {"key": "escape", "seconds": 0.08}
    ],
    "generic.pause": [
      {"key": "escape", "seconds": 0.08}
    ],
    "generic.jump": [
      {"key": "space", "seconds": 0.08}
    ]
  }
}
