{
  "game_id": "offline-example",
  "display_name": "Offline Example Game",
  "executable_names": ["ExampleGame.exe"],
  "window_title_pattern": "^Offline Example Game",
  "competitive_or_anticheat": false,
  "allow_vision": true,
  "allow_input": false,
  "allow_obs": true,
  "allow_twitch": false,
  "capture_fps": 1.0,
