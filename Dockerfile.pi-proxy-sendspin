FROM python:3.12-slim-bookworm

ARG SENDSPIN_VERSION=""
LABEL org.opencontainers.image.title="NekoSuneAI Pi Proxy Sendspin Player" \
      org.opencontainers.image.description="Sendspin player sidecar for NekoSuneAI Pi Proxy Bluetooth audio"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libportaudio2 libasound2-plugins alsa-utils pulseaudio-utils ffmpeg \
    && rm -rf /var/lib/apt/lists/*

RUN if [ -n "$SENDSPIN_VERSION" ]; then \
      pip install --no-cache-dir "sendspin==$SENDSPIN_VERSION"; \
    else \
      pip install --no-cache-dir sendspin; \
    fi

# PortAudio's ALSA backend can use this virtual device to send audio into the
# host PulseAudio/PipeWire server exposed through PULSE_SERVER. This is what
# lets a containerized Sendspin client play through the Pi's Bluetooth Echo
# even though that Bluetooth sink is not a physical /dev/snd card.
RUN printf '%s\n' \
    'pcm.pulse { type pulse }' \
    'ctl.pulse { type pulse }' \
    'pcm.!default { type pulse }' \
    'ctl.!default { type pulse }' \
    > /etc/asound.conf

RUN mkdir -p /data/sendspin

ENTRYPOINT ["sendspin", "daemon"]
CMD ["--settings-dir", "/data/sendspin", "--name", "NekoSuneAI Pi Proxy", "--manufacturer", "NekoSuneProjects", "--product-name", "NekoSuneAI Pi Proxy", "--hardware-volume", "true"]
