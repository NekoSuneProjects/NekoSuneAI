FROM python:3.12-slim-bookworm

ARG SENDSPIN_VERSION=""
LABEL org.opencontainers.image.title="NekoSuneAI Pi Proxy Sendspin Player" \
      org.opencontainers.image.description="Standalone Sendspin player sidecar for NekoSuneAI Pi Proxy Bluetooth audio"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libportaudio2 libasound2-plugins alsa-utils pulseaudio-utils ffmpeg \
    && rm -rf /var/lib/apt/lists/*

RUN if [ -n "$SENDSPIN_VERSION" ]; then \
      pip install --no-cache-dir "sendspin==$SENDSPIN_VERSION"; \
    else \
      pip install --no-cache-dir sendspin; \
    fi

# Route PortAudio's default ALSA output to the Pi host's PulseAudio /
# PipeWire-Pulse session via the socket mounted by Docker Compose.
RUN printf '%s\n' \
    'pcm.pulse { type pulse }' \
    'ctl.pulse { type pulse }' \
    'pcm.!default { type pulse }' \
    'ctl.!default { type pulse }' \
    > /etc/asound.conf

RUN mkdir -p /data/sendspin

ENTRYPOINT ["sendspin", "daemon"]
# Let Sendspin select the default output rather than failing while trying
# to resolve the ALSA plugin name "pulse" as an explicit PortAudio device.
CMD ["--settings-dir", "/data/sendspin", "--name", "NekoSuneAI Pi Proxy", "--manufacturer", "NekoSuneProjects", "--product-name", "NekoSuneAI Pi Proxy", "--hardware-volume", "false"]
