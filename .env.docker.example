# NekoSuneAI 1.2.1 - Raspberry Pi / Docker example
# Copy to .env, replace every REPLACE_ME value, then run:
#   docker compose up -d --build
# Never commit your real .env file.

# --- Container / dashboard -------------------------------------------------
WEB_DASHBOARD_HOST=0.0.0.0
WEB_DASHBOARD_PORT=8788
WEB_DASHBOARD_TOKEN=REPLACE_ME_LONG_RANDOM_DASHBOARD_TOKEN
PERIPHERAL_NODES_FILE=/app/data/peripheral_nodes.json
ROUTINES_FILE=/app/data/routines.json
SMART_HOME_DEVICES_FILE=/app/data/smart_home_devices.json
NEKOSUNEAI_ROOM=
ELECTRICITY_PRICE_PER_KWH=0.25
AUTO_UPDATE_CHECK=false
AUTO_UPDATE_INSTALL=false
AUTO_TUNE_PERFORMANCE=true
AUTO_TUNE_GOAL=balanced

# --- LLM (remote recommended for Raspberry Pi) -----------------------------
# Configure these in the dashboard after first launch, or uncomment as needed.
# LLM_PROVIDER=openai
# LLM_API_URL=https://api.openai.com/v1/chat/completions
# LLM_API_KEY=REPLACE_ME
# LLM_MODEL=gpt-4.1-mini

# --- Alexa Bluetooth output / Kinect 360 microphone ------------------------
# Pair/connect Alexa (or another Bluetooth speaker) on the Raspberry Pi HOST.
# NekoSuneAI scans /run/user/* at container startup, finds the active
# PulseAudio/PipeWire session, detects its UID/GID, and follows the host default
# sink automatically. Normally leave all audio-routing overrides unset.
NEKOSUNEAI_AUTO_AUDIO=true

# Optional compatibility overrides only. Most users should NOT set these.
# PUID=1000
# PGID=1000
# XDG_RUNTIME_DIR=/run/user/1000
# PULSE_SERVER=unix:/run/user/1000/pulse/native
# PIPEWIRE_REMOTE=pipewire-0

# Leave blank to follow the host's current default microphone/speaker.
MIC_DEVICE_INDEX=
SPEAKER_DEVICE_INDEX=
MIC_SAMPLE_RATE=16000
MIC_CHUNK_SIZE=1280
# 0 auto-detects Kinect as a four-channel array, then selects channel 0.
MIC_INPUT_CHANNELS=0
MIC_CHANNEL_INDEX=0
STT_END_SILENCE_TIMEOUT_MS=900
STT_PHRASE_TIME_LIMIT_SECONDS=30
STT_ENERGY_THRESHOLD=300
STT_DYNAMIC_ENERGY_THRESHOLD=true

# --- Wake word --------------------------------------------------------------
WAKE_WORD_ENABLED=true
# Built-in starter model. For "Hey Neko", mount a trained model under data/.
WAKE_WORD_MODEL=hey_jarvis
# ONNX avoids incompatible TFLite native-runtime builds on Raspberry Pi.
WAKE_WORD_FRAMEWORK=onnx
# Raise this to reduce false triggers; lower carefully if Kinect misses speech.
WAKE_WORD_THRESHOLD=0.55
WAKE_WORD_SOUND_ENABLED=true
WAKE_WORD_SOUND_PATH=/app/audio/wake.wav
WAKE_WORD_CONFIRMATION_FRAMES=3
WAKE_WORD_COOLDOWN_SECONDS=5

# --- Fast female remote TTS through nekoai-bridge ---------------------------
VOICE_ENABLED=true
TTS_PROVIDER=bridge
BRIDGE_WS_URL=wss://REPLACE_ME_BRIDGE_HOST/ws
BRIDGE_USER_ID=nekosuneai
BRIDGE_TTS_ENGINE=edge-stream
BRIDGE_TTS_VOICE=en-GB-SoniaNeural
BRIDGE_TTS_RATE=+10%
TTS_LANG=en-GB

# --- Local offline STT ------------------------------------------------------
STT_PROVIDER=vosk
# auto: systems with >=6 GB RAM (including Pi 5 8 GB) use the more accurate
# vosk-model-en-us-0.22-lgraph model. Smaller hosts use the old small model.
# Other choices: small, balanced, large, custom.
# large is the full 0.22 model and is intentionally opt-in because it is much
# heavier; balanced/lgraph is the recommended Pi 5 8 GB setting.
VOSK_MODEL_PROFILE=auto
# Only set VOSK_MODEL_PATH/URL when VOSK_MODEL_PROFILE=custom.
# VOSK_MODEL_PATH=/app/models/my-vosk-model
# VOSK_MODEL_URL=https://example.com/my-vosk-model.zip
STT_LANGUAGE=en
STT_TIMEOUT_SECONDS=15
BRIDGE_STT_TIMEOUT_SECONDS=90
STT_PHRASE_TIME_LIMIT_SECONDS=30

# --- MCP: choose ONE authentication example --------------------------------
MCP_ENABLED=true
MCP_AUTO_ROUTE=true
MCP_TIMEOUT_SECONDS=30

# API-key/mixed bridge mode: bearer Bridge User token + MCP API key.
MCP_SERVERS_JSON=[{"name":"nekoai-bridge","url":"https://REPLACE_ME_BRIDGE_HOST/mcp","auth":"api_key","bearer_token":"nai_REPLACE_ME","api_key":"REPLACE_ME_MCP_KEY","api_key_header":"X-API-Key"}]

# Used by Bridge WebSocket TTS/STT even when MCP itself is connected with OAuth.
BRIDGE_AUTH_TOKEN=nai_REPLACE_ME

# OAuth alternative - comment the API-key line above and uncomment this line.
# MCP_SERVERS_JSON=[{"name":"nekoai-bridge","url":"https://REPLACE_ME_BRIDGE_HOST/mcp","auth":"oauth","oauth_access_token":"oat_REPLACE_ME","oauth_refresh_token":"ort_REPLACE_ME","oauth_client_id":"REPLACE_ME_CLIENT_ID","oauth_token_url":"https://REPLACE_ME_BRIDGE_HOST/oauth/token"}]

# --- Emergency broadcasts and alert sounds ---------------------------------
EMERGENCY_BROADCAST_TTS=true
MONITOR_TTS_ENABLED=true
# Mount/copy WAV or MP3 files into ./audio on the host.
WARNING_SOUND_PATH=/app/audio/warning.wav
DANGER_SOUND_PATH=/app/audio/danger.wav
# Enabled by default in Docker. Leave the MAC blank: paired Alexa/Echo speakers
# are discovered automatically. Set a real MAC only if you want to pin one
# specific speaker when several Bluetooth audio devices are paired.
BLUETOOTH_RECONNECT_ENABLED=true
BLUETOOTH_SPEAKER_ADDRESS=
BLUETOOTH_RECONNECT_INTERVAL_SECONDS=10
# Legacy override for unusual hosts; normal audio playback no longer needs this.
# BLUETOOTH_GID=113

# --- Home Assistant MQTT discovery -----------------------------------------
HA_MQTT_HOST=REPLACE_ME_HOME_ASSISTANT_OR_MQTT_IP
HA_MQTT_PORT=1883
HA_MQTT_USERNAME=nekosuneai
HA_MQTT_PASSWORD=REPLACE_ME_MQTT_PASSWORD

# --- Media targets / TVs ----------------------------------------------------
# local, chromecast, dlna, android-tv, lg-webos or samsung-tv.
# You can also override per command: "pause on chromecast", "volume 30 on lg tv".
MEDIA_TARGET=local

# Google Cast / Chromecast. CAST_DEVICE is the friendly device name; CAST_HOST
# can be used instead when mDNS discovery is unavailable.
CAST_DEVICE=
CAST_HOST=

# DLNA/UPnP renderer. Leave blank for SSDP discovery, or set the device XML URL.
# Advanced users can provide control URLs directly.
DLNA_DEVICE_URL=
DLNA_AVTRANSPORT_URL=
DLNA_RENDERING_URL=

# Android TV / Google TV. ADB is included in the Docker image. Enable network
# debugging on the TV and enter its LAN IP (or IP:port when not using 5555).
ANDROID_TV_HOST=
# ADB_PATH=/usr/bin/adb

# LG webOS. The first connection displays a pairing prompt on the TV and logs a
# client key; save that value here so later commands do not need to pair again.
LG_WEBOS_HOST=
LG_WEBOS_CLIENT_KEY=

# Samsung Smart TV websocket remote (2016+ models where supported).
SAMSUNG_TV_HOST=
SAMSUNG_TV_TOKEN=
SAMSUNG_TV_NAME=NekoSuneAI
SAMSUNG_TV_SSL=true

# --- PlayStation 5 / PlayStation -------------------------------------------
# LAN discovery is read-only and does not register or bypass Sony protections.
# PS5_HOST is optional; leave blank to broadcast Remote Play discovery on LAN.
PS5_HOST=
PS_DISCOVERY_PROTOCOL_VERSION=00030010
PS_DISCOVERY_TIMEOUT=1.0

# Recommended control path: an authenticated paired-device/Remote Play bridge
# owned by you. NekoSuneAI calls GET /status and POST /command with a Bearer token.
PS_REMOTE_PLAY_BRIDGE_URL=
PS_REMOTE_PLAY_BRIDGE_TOKEN=

# Optional local helper commands when you already have a supported paired tool.
# Arguments are executed directly (no shell). {title} is substituted for launch.
PS_WAKE_COMMAND=
PS_REST_COMMAND=
PS_REMOTE_PLAY_COMMAND=
PS_LAUNCH_COMMAND=

# --- Xbox -------------------------------------------------------------------
# XBOX_HOST supplies a local reachability hint when no authenticated bridge is
# available. The bridge remains authoritative for state/current title/controller.
XBOX_HOST=
XBOX_MAC=

# Authenticated bridge contract: GET /status, POST /command with {action,value}.
XBOX_REMOTE_BRIDGE_URL=
XBOX_REMOTE_BRIDGE_TOKEN=

# Optional supported local helpers. {title} is substituted in launch commands.
XBOX_WAKE_COMMAND=
XBOX_SLEEP_COMMAND=
XBOX_SHUTDOWN_COMMAND=
XBOX_RESTART_COMMAND=
XBOX_LAUNCH_COMMAND=
XBOX_REMOTE_PLAY_COMMAND=

# --- Runtime behavior -------------------------------------------------------
INPUT_MODE=voice
HISTORY_TURNS=10
REQUEST_TIMEOUT=300
RAG_ENABLED=true
WEB_BROWSING_ENABLED=true
WEB_AUTO_SEARCH=false

# Raspberry Pi should not load local GPU/XTTS/Whisper stacks in this profile.
XTTS_USE_GPU=false
STT_USE_GPU=false
