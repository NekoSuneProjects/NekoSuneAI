# NekoSuneAI 1.2.1 - Raspberry Pi / Docker example
# Copy to .env, replace every REPLACE_ME value, then run:
#   docker compose up -d --build
# Never commit your real .env file.

# --- Container / dashboard -------------------------------------------------
WEB_DASHBOARD_HOST=0.0.0.0
WEB_DASHBOARD_PORT=8788
WEB_DASHBOARD_TOKEN=REPLACE_ME_LONG_RANDOM_DASHBOARD_TOKEN
AUTO_UPDATE_CHECK=false
AUTO_UPDATE_INSTALL=false
AUTO_TUNE_PERFORMANCE=true
AUTO_TUNE_GOAL=balanced

# --- LLM (remote recommended for Raspberry Pi) -----------------------------
# Configure these in the dashboard after first launch, or uncomment as needed.
# LLM_PROVIDER=openai
# LLM_API_URL=https://api.openai.com/v1/chat/completions
# LLM_API_KEY=REPLACE_ME
# LLM_MODEL=gpt-4.1-mini

# --- Alexa Bluetooth output / Kinect 360 microphone ------------------------
# Pair Alexa and select its A2DP output on the Raspberry Pi HOST first.
# Use `id -u`, `id -g`, `getent group audio`, and `getent group video` on the Pi.
PUID=1000
PGID=1000
AUDIO_GID=29
VIDEO_GID=44
XDG_RUNTIME_DIR=/run/user/1000
PULSE_SERVER=unix:/run/user/1000/pulse/native
# Find the Kinect index in Dashboard > Settings > Audio Devices.
MIC_DEVICE_INDEX=
SPEAKER_DEVICE_INDEX=
MIC_SAMPLE_RATE=16000
MIC_CHUNK_SIZE=1280
# 0 auto-detects Kinect as a four-channel array, then selects channel 0.
MIC_INPUT_CHANNELS=0
MIC_CHANNEL_INDEX=0
STT_END_SILENCE_TIMEOUT_MS=900
STT_PHRASE_TIME_LIMIT_SECONDS=30
STT_ENERGY_THRESHOLD=300
STT_DYNAMIC_ENERGY_THRESHOLD=true

# --- Wake word --------------------------------------------------------------
WAKE_WORD_ENABLED=true
# Built-in starter model. For "Hey Neko", mount a trained model under data/.
WAKE_WORD_MODEL=hey_jarvis
# ONNX avoids incompatible TFLite native-runtime builds on Raspberry Pi.
WAKE_WORD_FRAMEWORK=onnx
# Raise this to reduce false triggers; lower carefully if Kinect misses speech.
WAKE_WORD_THRESHOLD=0.55
WAKE_WORD_SOUND_ENABLED=true
WAKE_WORD_SOUND_PATH=/app/audio/wake.wav
WAKE_WORD_CONFIRMATION_FRAMES=3
WAKE_WORD_COOLDOWN_SECONDS=5

# --- Fast female remote TTS through nekoai-bridge ---------------------------
VOICE_ENABLED=true
TTS_PROVIDER=bridge
BRIDGE_WS_URL=wss://REPLACE_ME_BRIDGE_HOST/ws
BRIDGE_USER_ID=nekosuneai
BRIDGE_TTS_ENGINE=edge-stream
BRIDGE_TTS_VOICE=en-GB-SoniaNeural
BRIDGE_TTS_RATE=+10%
TTS_LANG=en-GB

# --- Remote STT through nekoai-bridge (keeps Whisper off the Pi) ------------
STT_PROVIDER=bridge
STT_LANGUAGE=en
STT_TIMEOUT_SECONDS=15
BRIDGE_STT_TIMEOUT_SECONDS=90
STT_PHRASE_TIME_LIMIT_SECONDS=30

# --- MCP: choose ONE authentication example --------------------------------
MCP_ENABLED=true
MCP_AUTO_ROUTE=true
MCP_TIMEOUT_SECONDS=30

# API-key/mixed bridge mode: bearer Bridge User token + MCP API key.
MCP_SERVERS_JSON=[{"name":"nekoai-bridge","url":"https://REPLACE_ME_BRIDGE_HOST/mcp","auth":"api_key","bearer_token":"nai_REPLACE_ME","api_key":"REPLACE_ME_MCP_KEY","api_key_header":"X-API-Key"}]

# Used by Bridge WebSocket TTS/STT even when MCP itself is connected with OAuth.
BRIDGE_AUTH_TOKEN=nai_REPLACE_ME

# OAuth alternative - comment the API-key line above and uncomment this line.
# MCP_SERVERS_JSON=[{"name":"nekoai-bridge","url":"https://REPLACE_ME_BRIDGE_HOST/mcp","auth":"oauth","oauth_access_token":"oat_REPLACE_ME","oauth_refresh_token":"ort_REPLACE_ME","oauth_client_id":"REPLACE_ME_CLIENT_ID","oauth_token_url":"https://REPLACE_ME_BRIDGE_HOST/oauth/token"}]

# --- Emergency broadcasts and alert sounds ---------------------------------
EMERGENCY_BROADCAST_TTS=true
MONITOR_TTS_ENABLED=true
# Mount/copy WAV or MP3 files into ./audio on the host.
WARNING_SOUND_PATH=/app/audio/warning.wav
DANGER_SOUND_PATH=/app/audio/danger.wav
BLUETOOTH_RECONNECT_ENABLED=true
BLUETOOTH_SPEAKER_ADDRESS=AA:BB:CC:DD:EE:FF
BLUETOOTH_RECONNECT_INTERVAL_SECONDS=10
# Run `getent group bluetooth` on the Pi and use the numeric group ID shown.
BLUETOOTH_GID=113

# --- Home Assistant MQTT discovery -----------------------------------------
HA_MQTT_HOST=REPLACE_ME_HOME_ASSISTANT_OR_MQTT_IP
HA_MQTT_PORT=1883
HA_MQTT_USERNAME=nekosuneai
HA_MQTT_PASSWORD=REPLACE_ME_MQTT_PASSWORD

# --- Runtime behavior -------------------------------------------------------
INPUT_MODE=voice
HISTORY_TURNS=10
REQUEST_TIMEOUT=300
RAG_ENABLED=true
WEB_BROWSING_ENABLED=true
WEB_AUTO_SEARCH=false

# Raspberry Pi should not load local GPU/XTTS/Whisper stacks in this profile.
XTTS_USE_GPU=false
STT_USE_GPU=false
