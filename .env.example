# Core
AUTO_TUNE_PERFORMANCE=true
AUTO_TUNE_GOAL=balanced
AUTO_UPDATE_CHECK=true
# SECURITY: keep this false unless you fully trust NEKOSUNEAI_GITHUB_REPO. When
# true, NekoSuneAI silently downloads a zip from that repo, overwrites local
# files and reruns setup.py on every launch — i.e. remote code execution by
# whoever controls the upstream repo. Leave it off and update manually with
# `python setup.py --update` when you've reviewed the release.
AUTO_UPDATE_INSTALL=false
AUTO_UPDATE_CACHE_SECONDS=21600
HF_HUB_DISABLE_SYMLINKS_WARNING=1
# owner/repo slug (a full https:// or git@ URL is also accepted and normalized)
NEKOSUNEAI_GITHUB_REPO=NekoSuneProjects/NekoSuneAI
NEKOSUNEAI_GITHUB_BRANCH=main

# LLM
# Providers: ollama | openai | claude-code | codex | cli
#   claude-code / codex shell out to the already-logged-in Claude Code / Codex
#   CLI (no API key, no re-auth — reuses ~/.claude and ~/.codex). Fast cloud
#   responses, great when local Ollama is slow. Requires the CLI installed and
#   logged in once (run `claude` or `codex` in a terminal). Works on
#   Windows/Mac/Linux.
LLM_PROVIDER=cli
LLM_MODEL=dolphin3
LLM_API_URL=
LLM_API_KEY=
LLM_KEEP_ALIVE=30m
LLM_NUM_PREDICT=1200
LLM_TEMPERATURE=0.95

# CLI providers (used when LLM_PROVIDER is claude-code / codex / cli)
# Optional model for the CLI (e.g. sonnet, opus, haiku for Claude; a model id
# for Codex). Leave blank to use the CLI's default.
LLM_CLI_MODEL=
# Override the executable path if `claude` / `codex` aren't on PATH.
CLAUDE_CLI_PATH=
CODEX_CLI_PATH=
# Full custom command for LLM_PROVIDER=cli. Use {prompt} to inject the prompt as
# an argument; omit it to receive the prompt on stdin. Examples:
#   LLM_CLI_COMMAND=claude -p --output-format text
#   LLM_CLI_COMMAND=codex exec --skip-git-repo-check
# Tip: prefer LLM_PROVIDER=codex / claude-code (handles the right flags for you).
LLM_CLI_COMMAND=

# OpenAI Compatible
OPENAI_MODEL=
OPENAI_API_URL=
OPENAI_API_KEY=
OPENAI_TEMPERATURE=

# Ollama
OLLAMA_MODEL=dolphin3
OLLAMA_API_URL=http://127.0.0.1:11434/api/chat
OLLAMA_SKIP_LOCAL_SETUP=false
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_PREDICT=1200
OLLAMA_TEMPERATURE=0.95

# Web Search
WEB_BROWSING_ENABLED=true
WEB_AUTO_SEARCH=false
WEB_SEARCH_PROVIDER=searxng
WEB_SEARCH_URL=https://searxng.nekosunevr.co.uk/
SEARXNG_URL=
WEB_MAX_RESULTS=5
WEB_TIMEOUT_SECONDS=15
WEB_REGION=us-en
WEB_SAFESEARCH=moderate

# Media (music search/streaming only — built-in radio stations were removed)
MUSIC_PROVIDER_DEFAULT=soundcloud
SOUNDCLOUD_STREAM_ENDPOINT=https://dl.nekosunevr.co.uk/api/stream

# Interaction
INPUT_MODE=voice
VOICE_ENABLED=false
TTS_PROVIDER=xtts
HISTORY_TURNS=10
REQUEST_TIMEOUT=300

# XTTS
XTTS_MODEL_NAME=tts_models/multilingual/multi-dataset/xtts_v2
XTTS_LANGUAGE=en
XTTS_SPEAKER=Ana Florence
XTTS_SPEAKER_WAV=
XTTS_USE_GPU=true
XTTS_STREAM_OUTPUT=true
XTTS_STREAM_CHUNK_SIZE=20
XTTS_STREAM_BUFFER_SECONDS=1.8
XTTS_CHUNK_MAX_CHARS=240
XTTS_MAX_TEXT_CHARS=5000
XTTS_SPEED=1.00

# Speech To Text
STT_PROVIDER=faster-whisper
STT_USE_GPU=true
STT_MODEL=small.en
STT_COMPUTE_TYPE=
STT_BEAM_SIZE=5
STT_BEST_OF=5
STT_VAD_FILTER=false
STT_LANGUAGE=en-US
STT_TIMEOUT_SECONDS=15
STT_PHRASE_TIME_LIMIT_SECONDS=30
STT_PAUSE_THRESHOLD_SECONDS=1.8
STT_NON_SPEAKING_DURATION_SECONDS=1.2
STT_AMBIENT_DURATION_SECONDS=0.6
STT_ENERGY_THRESHOLD=300
STT_DYNAMIC_ENERGY_THRESHOLD=true

# Audio Devices
MIC_DEVICE_INDEX=
SPEAKER_DEVICE_INDEX=
MIC_SAMPLE_RATE=
MIC_CHUNK_SIZE=1024

# RAG memory (learns/remembers across sessions; not model fine-tuning)
RAG_ENABLED=true
# local = sentence-transformers on CPU (default). ollama = use a local Ollama
# embedding model (e.g. embeddinggemma). openai = use an OpenAI-compatible
# /embeddings endpoint (reuses LLM_API_URL + LLM_API_KEY).
RAG_EMBEDDING_PROVIDER=local
# For local: a sentence-transformers id. For ollama: an Ollama model name
# (run `ollama pull embeddinggemma`). For openai: the API's embedding model id.
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=4
RAG_MIN_SCORE=0.25

# Game playing (VRChat only, via the official OSC API — enable OSC in VRChat's
# Action Menu). python-osc ships in requirements.txt.
GAME_ENABLED=false
GAME_TICK_SECONDS=4
# Optional multimodal vision model NekoSuneAI can use to "see" screenshots when
# asked (not required for VRChat OSC play). Reuses your LLM provider/credentials;
# e.g. an Ollama vision model like 'llava' or 'llama3.2-vision'.
VISION_MODEL=
VRCHAT_OSC_HOST=127.0.0.1
VRCHAT_OSC_PORT=9000
VRCHAT_OSC_READ_PORT=9001
# Folder containing VRChat's output log files (auto-detected if left blank).
VRCHAT_LOG_DIR=

# VRChat friends system (opt-in, separate from OSC play above). Uses VRChat's
# UNOFFICIAL web API to auto-accept friend requests and watch friend
# online/offline status live, plus a "thanks for the friend request" chatbox
# message. This is against VRChat's ToS for bots and could get the account
# flagged/banned — use a throwaway/alt account, not your main. Needs:
#   pip install vrchatapi pyotp websocket-client
# Leave VRCHAT_FRIENDS_ENABLED=false (the default) to never touch this at all.
VRCHAT_FRIENDS_ENABLED=false
VRCHAT_USERNAME=
VRCHAT_PASSWORD=
# Only needed if the account has authenticator-app (TOTP) 2FA. Email 2FA is not
# supported here since it needs an interactive code each login.
VRCHAT_TOTP_SECRET=

# Singing (Neuro-sama style). Backends:
#   local = fully local, no cloud/RVC. Fetches timed lyrics (LRCLIB) and performs
#           them in NekoSuneAI's XTTS voice ON the song's timing; optionally mixes
#           over a backing track you give it. (XTTS isn't pitched, so it's
#           on-beat talk-singing, not melodic singing — but it's 100% local.)
#   rvc   = local RVC voice-conversion of a vocal/acapella reference (.pth model).
#           See the RVC_CHAT_ENABLED note below — rvc-python isn't installable
#           alongside this project's other dependencies, so this backend needs
#           a separately-managed RVC install.
#   cloud = hosted singing/voice API.
# In the Sing box: type "Artist - Title" to fetch timed lyrics, or paste lyrics
# directly. The optional backing field accepts a file path (.wav/.mp3) OR a
# YouTube URL (downloaded via yt-dlp); leave it blank to auto-find an
# instrumental. Vocals + backing are always merged into one saved song file.
SINGING_ENABLED=true
SINGING_BACKEND=local
# When no backing is given, auto-find an instrumental/karaoke track on YouTube to
# sing over. Attaching your own backing — a file path or a pasted YouTube URL —
# is optional and overrides this. Vocals + backing are merged into ONE file.
#   Needs: pip install yt-dlp imageio-ffmpeg
#   ffmpeg (from imageio-ffmpeg, system PATH, or FFMPEG_PATH=...) is REQUIRED to
#   decode + merge the backing with the voice. Without it, only the voice plays.
# Rendered songs are saved in audio/songs/ and replayed from there next time you
# sing the same thing. (Works with TTS_PROVIDER=xtts or gtts.)
SINGING_FETCH_INSTRUMENTAL=true
RVC_MODEL_PATH=
SINGING_API_URL=
SINGING_API_KEY=

# RVC voice conversion for normal spoken chat replies (separate from the singing
# RVC model above — chat and singing usually use different trained voices).
# When enabled, every spoken reply is rendered by XTTS/gTTS as usual, then passed
# through this RVC model before playback.
# rvc-python is NOT in requirements-voice.txt — it pins numpy<=1.23.5, which
# conflicts with this project's numpy>=1.24. Install it in its own virtualenv,
# or accept the numpy downgrade at your own risk with:
#   pip install "rvc-python>=0.1" --no-deps
# Forces non-streaming XTTS synthesis (the whole line must be rendered before it
# can be converted), so replies take slightly longer to start speaking.
RVC_CHAT_ENABLED=false
RVC_CHAT_MODEL_PATH=
# Pitch shift in semitones, positive = higher, negative = lower.
RVC_CHAT_PITCH=0
RVC_CHAT_INDEX_RATE=0.75
RVC_CHAT_PROTECT=0.33

# Thinking music — plays a short local audio file only when a reply/action is
# taking noticeably long to generate (not on every turn), and stops the instant
# it's ready. Off by default; needs a real audio file path to do anything.
THINKING_SOUND_ENABLED=false
THINKING_SOUND_PATH=
THINKING_SOUND_DELAY_SECONDS=2.5
