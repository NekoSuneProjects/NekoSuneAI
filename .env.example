# Most day-to-day settings (LLM provider/model/API key, voice, speech-to-text,
# web search, memory, media, singing, VRChat friends, VRChat OSC) now live in
# the app's Settings panel and are stored in SQLite, live-editable with no
# restart needed. This file only covers things that AREN'T there yet: startup/
# performance tuning, CLI-provider paths, low-level audio/model knobs, and the
# self-update mechanism. The app boots fine with no .env file at all — every
# value below has a built-in default; only set what you actually want to change.

# Core
AUTO_TUNE_PERFORMANCE=true
AUTO_TUNE_GOAL=balanced
AUTO_UPDATE_CHECK=true
# SECURITY: keep this false unless you fully trust NEKOSUNEAI_GITHUB_REPO. When
# true, NekoSuneAI silently downloads a zip from that repo, overwrites local
# files and reruns setup.py on every launch — i.e. remote code execution by
# whoever controls the upstream repo. Leave it off and update manually with
# `python setup.py --update` when you've reviewed the release.
AUTO_UPDATE_INSTALL=false
AUTO_UPDATE_CACHE_SECONDS=21600
HF_HUB_DISABLE_SYMLINKS_WARNING=1
# owner/repo slug (a full https:// or git@ URL is also accepted and normalized)
NEKOSUNEAI_GITHUB_REPO=NekoSuneProjects/NekoSuneAI
NEKOSUNEAI_GITHUB_BRANCH=main

# LLM tuning — provider, model, API URL/key and temperature are now set in
# Settings → AI Provider & Models. This one has no Settings-UI equivalent yet.
LLM_KEEP_ALIVE=30m

# CLI providers (used when Settings → AI Provider & Models → Provider is
# claude-code / codex / cli). No Settings-UI equivalent — these are
# executable paths / raw commands, not user-facing model choices.
#   claude-code / codex shell out to the already-logged-in Claude Code / Codex
#   CLI (no API key, no re-auth — reuses ~/.claude and ~/.codex). Requires the
#   CLI installed and logged in once (run `claude` or `codex` in a terminal).
# Optional model for the CLI (e.g. sonnet, opus, haiku for Claude; a model id
# for Codex). Leave blank to use the CLI's default.
LLM_CLI_MODEL=
# Override the executable path if `claude` / `codex` aren't on PATH.
CLAUDE_CLI_PATH=
CODEX_CLI_PATH=
# Full custom command for Provider=cli. Use {prompt} to inject the prompt as
# an argument; omit it to receive the prompt on stdin. Examples:
#   LLM_CLI_COMMAND=claude -p --output-format text
#   LLM_CLI_COMMAND=codex exec --skip-git-repo-check
LLM_CLI_COMMAND=

# Ollama — model/URL are set in Settings → AI Provider & Models (Provider:
# ollama). These two have no Settings-UI equivalent.
# Skip local Ollama install/start/model-pull when pointing at an existing
# Ollama server instead (set your server's URL in Settings too).
OLLAMA_SKIP_LOCAL_SETUP=false
OLLAMA_NUM_PREDICT=1200

# Web search, memory (RAG), media, singing, RVC voice conversion, thinking
# music, and VRChat (friends + OSC) settings all moved to the Settings panel —
# see Settings → Web Search / Memory (RAG) / Media / Singing / Voice /
# VRChat Friends, and the Game page for VRChat OSC. Web search and voice also
# have quick on/off toggles right in the chat UI.

# Interaction — input mode and voice on/off are toggled from the chat UI now
# (and remembered between sessions); these two have no Settings-UI equivalent.
HISTORY_TURNS=10
REQUEST_TIMEOUT=300

# Remote MCP / nekoai-bridge (Pi-friendly: heavy tools and voice run remotely).
# Put this JSON on one line. auth may be "api_key" (bearer + key header) or
# "oauth" (access token, optionally refreshed with token URL/client details).
MCP_ENABLED=false
MCP_AUTO_ROUTE=true
MCP_TIMEOUT_SECONDS=30
MCP_SERVERS_JSON=[]
# Example API-key entry:
# MCP_SERVERS_JSON=[{"name":"nekoai-bridge","url":"https://bridge.example/mcp","auth":"api_key","bearer_token":"nai_REPLACE","api_key":"REPLACE","api_key_header":"X-API-Key"}]
# Example OAuth entry (access-only fields are enough until it expires):
# MCP_SERVERS_JSON=[{"name":"nekoai-bridge","url":"https://bridge.example/mcp","auth":"oauth","oauth_access_token":"oat_REPLACE","oauth_refresh_token":"ort_REPLACE","oauth_client_id":"CLIENT","oauth_token_url":"https://bridge.example/oauth/token"}]
BRIDGE_WS_URL=
BRIDGE_USER_ID=nekosuneai
BRIDGE_TTS_VOICE=
BRIDGE_TTS_ENGINE=edge-stream
BRIDGE_TTS_RATE=+10%
WARNING_SOUND_PATH=
DANGER_SOUND_PATH=
EMERGENCY_BROADCAST_TTS=true

# Browser dashboard (the startup URL includes the token). Set a stable secret
# so bookmarks keep working across container restarts.
WEB_DASHBOARD_HOST=0.0.0.0
WEB_DASHBOARD_PORT=8788
WEB_DASHBOARD_TOKEN=

# Local wake word. Built-in openWakeWord model defaults to "hey_jarvis"; use a
# custom .onnx/.tflite model path for your own Neko phrase.
WAKE_WORD_ENABLED=false
WAKE_WORD_MODEL=hey_jarvis
WAKE_WORD_THRESHOLD=0.55

# Home Assistant MQTT discovery (Mosquitto is recommended).
HA_MQTT_HOST=
HA_MQTT_PORT=1883
HA_MQTT_USERNAME=
HA_MQTT_PASSWORD=

# XTTS — speaker, speaker-clone .wav, speed and language are in Settings →
# Voice. These are lower-level model/streaming knobs with no Settings-UI
# equivalent yet.
XTTS_MODEL_NAME=tts_models/multilingual/multi-dataset/xtts_v2
XTTS_USE_GPU=true
XTTS_STREAM_OUTPUT=true
XTTS_STREAM_CHUNK_SIZE=20
XTTS_STREAM_BUFFER_SECONDS=1.8
XTTS_CHUNK_MAX_CHARS=240
XTTS_MAX_TEXT_CHARS=5000

# Speech To Text — engine, model and language are in Settings →
# Speech-to-Text. These are lower-level recognition/VAD knobs with no
# Settings-UI equivalent yet.
STT_USE_GPU=true
STT_COMPUTE_TYPE=
STT_BEAM_SIZE=5
STT_BEST_OF=5
STT_VAD_FILTER=false
STT_TIMEOUT_SECONDS=15
STT_PHRASE_TIME_LIMIT_SECONDS=30
STT_PAUSE_THRESHOLD_SECONDS=1.8
STT_NON_SPEAKING_DURATION_SECONDS=1.2
STT_AMBIENT_DURATION_SECONDS=0.6
STT_ENERGY_THRESHOLD=300
STT_DYNAMIC_ENERGY_THRESHOLD=true

# Audio Devices
MIC_DEVICE_INDEX=
SPEAKER_DEVICE_INDEX=
MIC_SAMPLE_RATE=
MIC_CHUNK_SIZE=1024

# Game playing (VRChat only). Whether the game agent runs at all — the
# OSC host/ports, vision model and think-interval are in Settings → the
# Game page. python-osc ships in requirements.txt.
GAME_ENABLED=false

# Singing — enabled/backend/RVC path/cloud API are in Settings → Singing.
# This knob has no Settings-UI equivalent: when no backing track is given,
# auto-find an instrumental/karaoke track on YouTube to sing over (a file
# path or pasted YouTube URL in the Sing box overrides this).
#   Needs: pip install yt-dlp imageio-ffmpeg
#   ffmpeg (from imageio-ffmpeg, system PATH, or FFMPEG_PATH=...) is REQUIRED to
#   decode + merge the backing with the voice. Without it, only the voice plays.
# Rendered songs are saved in audio/songs/ and replayed from there next time.
SINGING_FETCH_INSTRUMENTAL=true

# RVC voice conversion (chat and singing, configured separately in Settings →
# Voice / Singing) is lazy-imported and NOT in requirements-voice.txt — it
# pins numpy<=1.23.5, which conflicts with this project's numpy>=1.24. Install
# it in its own virtualenv, or accept the numpy downgrade at your own risk with:
#   pip install "rvc-python>=0.1" --no-deps
