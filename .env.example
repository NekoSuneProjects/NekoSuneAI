# Pi Proxy .env -- optional. Same idea as the Docker backend's .env: these
# override the values in your JSON config file (config/pi-proxy-agent.json /
# the /data/pi-proxy-agent.json a container mounts) for this run only. They
# are never written back into the JSON file, so removing a line here just
# falls back to whatever the JSON file already has.
#
# Copy this file to .env next to compose.pi-proxy.yml and uncomment/fill in
# whatever you want to set via environment instead of editing the JSON file
# directly (handy for compose/systemd deployments, secrets managers, etc.).
# Leave a line commented out (or blank) to use the JSON file's value.

# PI_PROXY_SERVER_URL=https://your-nekosuneai-host.example
# PI_PROXY_NODE_ID=pi-proxy-living-room
# PI_PROXY_NAME=Living Room Pi Proxy
# PI_PROXY_DEVICE_TOKEN=
# PI_PROXY_VERIFY_TLS=true

# Alexa/Echo Bluetooth auto-connect. Address is optional -- left blank, the
# watchdog auto-discovers a paired audio device on the host, preferring
# Alexa/Echo/Amazon names. The speaker must be paired (and ideally trusted)
# on the host once first via `bluetoothctl` -- see docs/RASPBERRY_PI_VOICE_HOME.md
# -- this only reconnects/selects it afterward, it does not pair new devices.
BLUETOOTH_RECONNECT_ENABLED=true
# BLUETOOTH_SPEAKER_ADDRESS=
# BLUETOOTH_RECONNECT_INTERVAL_SECONDS=10

# AUDIO_LISTEN_SECONDS=5

# Local wake word -- off by default, needs a real microphone + model file.
# WAKE_WORD_ENABLED=false
# WAKE_WORD_MODEL=hey_jarvis
# WAKE_WORD_FRAMEWORK=onnx
# WAKE_WORD_THRESHOLD=0.55
# WAKE_WORD_CONFIRMATION_FRAMES=3
# WAKE_WORD_COOLDOWN_SECONDS=5
# WAKE_WORD_LISTEN_SECONDS=5
# MIC_DEVICE_INDEX=

# WEB_STATUS_ENABLED=true
# WEB_STATUS_PORT=8799

# ALERT_SOUNDS_DIR=sounds

# Xbox 360 Kinect camera -- off by default, needs real libfreenect/Kinect hardware.
# KINECT_VISION_ENABLED=false
# KINECT_DEVICE_INDEX=0
# KINECT_VISION_INTERVAL_SECONDS=4
# KINECT_FACE_EMOTION=true
# KINECT_VISION_DESCRIBE=true
