{
  "schema_version": 1,
  "game_id": "vrchat",
  "display_name": "VRChat (OSC)",
  "profile": {
    "executable_names": [
      "VRChat.exe"
    ],
    "window_title_pattern": "^VRChat(?:\\s|$)",
    "platform": "vrchat",
    "allow_vision": true,
    "allow_input": true,
    "allow_keyboard": false,
    "allow_mouse": false,
    "allow_controller": false,
    "allow_obs": true,
    "allow_twitch": false,
    "competitive_or_anticheat": false,
    "multiplayer_policy": "permitted_multiplayer",
    "automation_permitted": true,
    "realtime_enabled": false,
    "capture_fps": 1,
    "capture_width": 1280
  },
  "skills": {
